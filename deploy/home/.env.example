# DopaCheck 홈서버 배포 — **앱 컨테이너용** .env 스키마 (키 이름만. 실제 값은 서버에만 둔다)
#
# ⚠️ DB 초기화 전용 키(MARIADB_*)는 이 파일에 넣지 않는다 — `.env.db.example` 참고.
#    compose 의 `env_file` 은 파일의 **모든** 키를 컨테이너 환경에 넣으므로, 여기에 DB root
#    비밀번호가 섞이면 앱이 쓰지도 않는 슈퍼유저 크레덴셜이 앱 프로세스 환경에 상주한다
#    (`/proc/self/environ`·`docker inspect dopacheck-app` 로 평문 노출).
#
# 만들기(600 으로 먼저 만들고 값을 넣는다 — 값을 쓴 뒤 chmod 하면 world-readable 구간이 생긴다):
#   install -m 600 .env.example .env
#
# ⚠️ 값에 `$` 를 쓰지 말 것 — compose 의 dotenv 파서가 변수로 보간해 **경고 없이** 값을 변조한다
#    (`ab$c#d` → `ab#d`). 앱은 원본 값으로 접속하므로 recreate 직후 인증이 전부 실패한다.
#    꼭 써야 하면 `$$` 로 이스케이프한다.
#
# 【필수】 표시된 키는 compose 가 `:?required` 로 강제한다 — 비어 있으면 `up` 이 멈춘다.
# 나머지는 앱이 부팅 시 검사하거나(routes/auth.py `_require_env`) 기본값이 있다.

# ── DB 접속 (같은 스택의 mariadb 컨테이너) ────────────
# ⚠️ DB_HOST 는 **고유 컨테이너명** `dopacheck-mariadb` 를 쓴다. 서비스명을 쓰지 말 것 —
#    앱 컨테이너는 공유망 shared-net 에도 조인돼 있고, 도커 내장 DNS 는 조인된 **모든** 네트워크의
#    별칭을 대상으로 이름을 해석한다. 다른 스택이 같은 일반명을 게시하면 남의 DB 로 접속할 수 있다
#    (2026-08-23 실측: shared-net 에 `app` 별칭을 네 스택이 공유하고 있었다 — luma200ok/home-infra#15).
DB_HOST=dopacheck-mariadb
DB_PORT=3306
DB_NAME=          # 【필수】 mariadb MARIADB_DATABASE 로도 보간된다
# 앱 전용 계정 — root 가 아니다. compose 가 신규 볼륨에 이 계정을 만든다(MARIADB_USER).
DB_USER=          # 【필수】
DB_PASSWORD=      # 【필수】
DB_POOL_SIZE=
DB_POOL_TIMEOUT=

# ── OAuth ────────────────────────────────────────────
# ⚠️ REDIRECT_URI 가 비면 앱이 `url_for(_external=True)` 폴백을 타고, 그 호스트가
#    요청 헤더(X-Forwarded-Host)로 결정된다 — 홈서버 이전으로 신뢰 홉(nginx)이 사라졌기 때문이다.
#    그래서 compose 가 `:?required` 로 막는다(빈 값도 막힌다). 반드시 공개 도메인 기준으로 채울 것.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dopacheck.luma200ok.com/auth/google/callback   # 【필수】
KAKAO_CLIENT_ID=
# 카카오 보안 설정에서 client_secret 을 켠 경우에만. 끄면 비워 둔다.
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://dopacheck.luma200ok.com/auth/kakao/callback     # 【필수】

# ── 외부 API ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Flask ────────────────────────────────────────────
# ⚠️ 빈 문자열이면 KeyError 가 아니라 **NullSession** 이 된다 — 컨테이너는 정상 기동하고
#    healthcheck 도 통과하는데 세션을 쓰는 요청(로그인 등)만 전부 500 이 난다.
#    무증상 장애라 compose 가 `:?required` 로 막는다.
FLASK_SECRET_KEY=  # 【필수】
# FLASK_ENV 는 compose 의 environment 로 production 이 강제되므로 여기 값은 무시된다
# (environment 가 env_file 보다 우선). 혼동을 피하려 아예 두지 않는다.
# 공개 서비스이므로 True.
SESSION_COOKIE_SECURE=True
