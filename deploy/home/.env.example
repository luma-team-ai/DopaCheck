# DopaCheck 홈서버 배포 — 서버 로컬 .env 스키마 (키 이름만. 실제 값은 서버에만 둔다)
#
# 만들기(600 으로 먼저 만들고 값을 넣는다 — 값을 쓴 뒤 chmod 하면 world-readable 구간이 생긴다):
#   install -m 600 .env.example .env
#
# ⚠️ 값에 `$` 를 쓰지 말 것 — compose 의 dotenv 파서가 변수로 보간해 **경고 없이** 값을 변조한다
#    (`ab$c#d` → `ab#d`). 앱은 원본 값으로 접속하므로 recreate 직후 인증이 전부 실패한다.
#    꼭 써야 하면 `$$` 로 이스케이프한다.

# ── DB (같은 스택의 mariadb 컨테이너) ─────────────────
# DB_HOST 는 컨테이너 서비스명. MARIADB_ROOT_PASSWORD 와 DB_PASSWORD 가 같은 계정을 가리키는지 확인할 것.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=
DB_POOL_TIMEOUT=
# mariadb 컨테이너 초기화용 — compose 가 :?required 가드로 강제한다.
MARIADB_ROOT_PASSWORD=

# ── OAuth ────────────────────────────────────────────
# REDIRECT_URI 는 공개 도메인 기준(https://dopacheck.luma200ok.com/...)이어야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=

# ── 외부 API ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Flask ────────────────────────────────────────────
# 공개 서비스이므로 SESSION_COOKIE_SECURE 는 True.
FLASK_ENV=
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=
